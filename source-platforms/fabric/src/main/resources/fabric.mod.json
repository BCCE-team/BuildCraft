{
  "schemaVersion": 1,
  "id": "buildcraftlib",
  "version": "${mod_version}",
  "name": "BuildCraft Community Edition - Fabric Gameplay Parity",
  "description": "Experimental 1.20.1 Fabric gameplay-parity target with the shared BuildCraft module bootstrap and server registrations enabled.",
  "authors": [
    "${mod_authors}"
  ],
  "license": "${mod_license}",
  "environment": "*",
  "entrypoints": {
    "main": [
      "buildcraft.fabric.BuildCraftFabric"
    ],
    "client": [
      "buildcraft.fabric.BuildCraftFabricClient"
    ]
  },
  "mixins": [
    "buildcraft.fabric.mixins.json"
  ],
  "accessWidener": "buildcraft.accesswidener",
  "depends": {
    "fabricloader": "${loader_version_range}",
    "fabric-api": "${fabric_api_version_range}",
    "minecraft": "${minecraft_version_range}",
    "java": ">=17"
  },
  "custom": {
    "buildcraft:gameplay_parity": true,
    "buildcraft:target": "1.20.1-fabric",
    "buildcraft:module_bootstrap": true
  },
  "provides": [
    "buildcraftcore",
    "buildcraftbuilders",
    "buildcraftenergy",
    "buildcraftfactory",
    "buildcraftrobotics",
    "buildcraftsilicon",
    "buildcrafttransport"
  ]
}
