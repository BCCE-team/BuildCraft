{
  "multipart": [
    {
      "when": {
        "facing": "north",
        "redstone_module": "false"
      },
      "apply": {
        "model": "buildcraftbuilders:block/filler/main"
      }
    },
    {
      "when": {
        "facing": "north",
        "redstone_module": "true"
      },
      "apply": {
        "model": "buildcraftbuilders:block/filler/main_redstone"
      }
    },
    {
      "when": {
        "facing": "east",
        "redstone_module": "false"
      },
      "apply": {
        "model": "buildcraftbuilders:block/filler/main",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "east",
        "redstone_module": "true"
      },
      "apply": {
        "model": "buildcraftbuilders:block/filler/main_redstone",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south",
        "redstone_module": "false"
      },
      "apply": {
        "model": "buildcraftbuilders:block/filler/main",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "south",
        "redstone_module": "true"
      },
      "apply": {
        "model": "buildcraftbuilders:block/filler/main_redstone",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west",
        "redstone_module": "false"
      },
      "apply": {
        "model": "buildcraftbuilders:block/filler/main",
        "y": 270
      }
    },
    {
      "when": {
        "facing": "west",
        "redstone_module": "true"
      },
      "apply": {
        "model": "buildcraftbuilders:block/filler/main_redstone",
        "y": 270
      }
    }
  ]
}
